# Required. Prisma provider is postgresql (production + local).
# Get a free Neon or Vercel Postgres connection string.
# Example:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
# Local Docker:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cmt_estimate?schema=public"
# SQLite file:./dev.db is no longer supported. After switch: migrate deploy then db:seed
