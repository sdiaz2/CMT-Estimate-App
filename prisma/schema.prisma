generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ParentTaskCatalog {
  id             String   @id @default(cuid())
  name           String   @unique
  sortOrder      Int
  category       String   @default("field")
  relatedHints   String   @default("[]")
  defaultDrivers String   @default("{}")
  lineTemplates  LineTemplate[]
  projectParents ProjectParent[]
}

model LineTemplate {
  id              String @id @default(cuid())
  catalogId       String
  catalog         ParentTaskCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  description     String
  units           String
  isLab           Boolean @default(false)
  includesOT      Boolean @default(false)
  includesVehicle Boolean @default(false)
  sortOrder       Int     @default(0)
  qtyHint         String  @default("")
}

model Project {
  id                          String   @id @default(cuid())
  name                        String
  location                    String   @default("")
  notes                       String   @default("")
  docsReceived                String   @default("")
  /// Building area takeoff (SF) for earthwork trip rule
  buildingAreaSf              Float?
  /// Moisture-conditioned subgrade under building
  moistureConditionedSubgrade Boolean  @default(false)
  /// Flexible base cap over moisture-conditioned subgrade
  flexibleBaseCap             Boolean  @default(false)
  /// SF of building area per earthwork trip (typical range 2700–3000; default mid 2850)
  earthworkSfPerTrip          Float    @default(2850)
  /// Optional note e.g. moisture conditioning depth
  moistureDepthNote           String   @default("")
  /// Optional note e.g. flexible base thickness
  flexibleBaseThicknessNote   String   @default("")
  /// Pavement area takeoff (SF) for lime-treated pavement subgrade trip rule
  pavementAreaSf              Float?
  /// Lime-treated pavement subgrade condition (true → SF rule; false → LF rule)
  limeTreatedPavementSubgrade Boolean  @default(false)
  /// SF of pavement per earthwork trip when lime-treated (typical 25000–30000; default mid 27500)
  pavementSfPerTrip           Float    @default(27500)
  /// Pavement subgrade length (LF) when NOT lime-treated
  pavementSubgradeLf          Float?
  /// LF of pavement subgrade per earthwork trip when not lime-treated (typical 200–400; default mid 300)
  pavementLfPerTrip           Float    @default(300)
  /// Optional notes for pavement / lime treatment
  pavementNotes               String   @default("")
  /// Sidewalk length takeoff (LF) for sitework sidewalk earthwork trips
  sidewalkLf                  Float?
  /// When true, sidewalks are bunched (use bunched LF/trip); when false, spread out
  sidewalksBunchedTogether    Boolean  @default(false)
  /// LF per trip when sidewalks are spread out (default 125)
  sidewalkSpreadLfPerTrip     Float    @default(125)
  /// LF per trip when sidewalks are bunched together (default 150)
  sidewalkBunchedLfPerTrip    Float    @default(150)
  /// Utility trench backfill length (LF) for storm/sewer/water trench earthwork trips
  utilityTrenchLf             Float?
  /// LF of utility trench per earthwork trip (typical 150–175; default mid 162.5)
  utilityTrenchLfPerTrip      Float    @default(162.5)
  /// Optional schedule-provided trip count for CIP Deep Foundations (null/0 = none; overrides pier rules)
  foundationScheduleTrips     Int?
  /// Number of drilled piers for CIP Deep Foundations trip rule
  pierCount                   Int?
  /// Pier type: straight_shaft | cased | belled
  pierType                    String   @default("straight_shaft")
  /// Piers per trip for straight-shaft (typical 9–12; default mid 10.5)
  piersPerTripStraight        Float    @default(10.5)
  /// Piers per trip for cased piers (typical 4–6; default 5)
  piersPerTripCased           Float    @default(5)
  /// Piers per trip for belled/underreamed (typical 5–9; default 7)
  piersPerTripBelled          Float    @default(7)
  /// Grade beams / pier caps concrete volume (yd³) for Concrete Testing trip rule A
  concreteYd3GradeBeamsPierCaps Float?
  /// yd³ per trip for grade beams / pier caps (typical 100–175; default mid 137.5)
  yd3PerTripGradeBeams        Float    @default(137.5)
  /// Building slab concrete volume (yd³) for Concrete Testing trip rule B
  concreteYd3BuildingSlab     Float?
  /// yd³ per trip for building slab (default 300)
  yd3PerTripBuildingSlab      Float    @default(300)
  /// Private pavement concrete volume (yd³) for Concrete Testing trip rule C
  concreteYd3PrivatePavement  Float?
  /// yd³ per trip for private pavement (default 500)
  yd3PerTripPrivatePavement   Float    @default(500)
  /// Public pavement concrete volume (yd³) for Concrete Testing trip rule C
  concreteYd3PublicPavement   Float?
  /// yd³ per trip for public pavement (default 900)
  yd3PerTripPublicPavement    Float    @default(900)
  /// Load-bearing CMU wall area (SF) for Masonry Testing trip rule A
  masonryLoadBearingCmuSf     Float?
  /// SF of load-bearing CMU per masonry trip (default 5000)
  masonrySfPerTripLoadBearingCmu Float @default(5000)
  /// Number of multifamily buildings with an elevator (Masonry rule B)
  masonryElevatorBuildingCount Int?
  /// Elevator shaft CMU wall height per building (ft) for Masonry rule B
  masonryElevatorShaftHeightFt Float?
  /// Feet of elevator shaft height per masonry trip (default 16)
  masonryFtPerTripElevatorShaft Float @default(16)
  /// Dumpster and/or equipment CMU enclosure count (Masonry rule C; 1 trip each)
  masonryCmuEnclosureCount    Int?
  /// Grout baseplates present in special inspection requirements (High-Strength Grout trip rule)
  groutBaseplatesInSpecialInspection Boolean @default(false)
  /// Building pad area (SF) for High-Strength Grout trips; often equals building area — if null, fall back to buildingAreaSf
  buildingPadSf               Float?
  /// SF of building pad per High-Strength Grout trip when baseplates are in special inspection (default 17000)
  ft2PerTripGroutBaseplates   Float    @default(17000)
  /// Dedicated structural steel building area (SF); if null, fall back to buildingAreaSf
  structuralSteelBuildingSf   Float?
  /// SF of building per Structural Steel inspection trip (default 20000)
  structuralSteelSfPerTrip    Float    @default(20000)
  /// Final inspection trips added when area-based steel trips apply (default 1)
  structuralSteelFinalInspectionTrips Float @default(1)
  /// Number of structure levels — steel trips are multiplied by this (default 1, min 1)
  structureLevelCount         Int      @default(1)
  /// Building slab-on-grade pour count for Floor Flatness Testing trip rule
  slabOnGradePourCount        Int?
  /// Floor flatness / building slab area (SF); if null, fall back to buildingAreaSf
  floorFlatnessSf             Float?
  /// SF per Floor Flatness trip (default 30000)
  ft2PerTripFloorFlatness     Float    @default(30000)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  parents                     ProjectParent[]
}

model ProjectParent {
  id        String @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  catalogId String
  catalog   ParentTaskCatalog @relation(fields: [catalogId], references: [id])
  sortOrder Int    @default(0)
  drivers   String @default("{}")
  lineItems LineItem[]

  @@unique([projectId, catalogId])
}

model LineItem {
  id              String  @id @default(cuid())
  projectParentId String
  projectParent   ProjectParent @relation(fields: [projectParentId], references: [id], onDelete: Cascade)
  description     String
  quantity        Float   @default(0)
  units           String
  trips           Float?
  isLab           Boolean @default(false)
  sortOrder       Int     @default(0)
  notes           String  @default("")
  rateDisplay     Float?
}
